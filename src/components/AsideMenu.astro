---
import IsotypeAnchor from "./IsotypeAnchor.astro";
import CrossButton from "./CrossButton.astro";
import RightArrow from "./icons/RightArrow.astro";
import FBIcon from "./icons/FBIcon.astro";
import IGIcon from "./icons/IGIcon.astro";
import type { Route } from "../utils/routes";
import LangButton from "./buttons/LangButton.astro";
import type {
  BrandCopy,
  LanguageSwitcherCopy,
  MenuCopy,
} from "../i18n/content";

interface Props {
  navLinks: Route[];
  brand: BrandCopy;
  langSwitcher: LanguageSwitcherCopy;
  menu: MenuCopy;
}

const { navLinks, brand, langSwitcher, menu }: Props = Astro.props;
---

<aside
  id="aside-menu"
  class="pointer-events-none fixed inset-0 z-20 bg-third/45 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Navigation menu"
  inert
>
  <div
    id="aside-panel"
    class="absolute inset-y-0 right-0 flex h-dvh w-full flex-col bg-[#DEF3F4] shadow-[-24px_0_70px_rgba(20,26,58,0.2)] will-change-transform sm:w-[min(30rem,100vw)]"
    style="transform: translateX(100%); opacity: 0; filter: blur(4px);"
  >
    <header class="flex min-h-18 items-center justify-between border-b border-third/8 px-5 text-black sm:px-8">
      <IsotypeAnchor
        homeUrl={brand.homeUrl}
        desktopLogoSrc={brand.desktopLogoSrc}
        mobileLogoSrc={brand.mobileLogoSrc}
        alt={brand.logoAlt}
      />
      <CrossButton />
    </header>

    <section class="flex min-h-0 flex-1 flex-col">
      <div class="min-h-0 flex-1 overflow-y-auto">
        <nav>
          <ul class="px-5 py-6 sm:px-8">
            {
              navLinks.map((x) => (
                <li>
                  <a
                    data-nav-link
                    class="group flex items-center justify-between gap-6 border-b border-third/10 py-5 text-third"
                    href={x.url}
                  >
                    <div class="flex flex-col gap-1">
                      <span class="text-lg uppercase tracking-[0.04em]">
                        {x.label}
                      </span>
                      <span class="text-sm normal-case leading-relaxed opacity-65">
                        {x.description}
                      </span>
                    </div>
                    <RightArrow class="h-5 w-5 shrink-0 text-third transition-transform group-hover:translate-x-1" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

      </div>

      <div class="mt-auto border-t border-third/10 bg-white/25">
        <div class="px-5 py-6 text-third sm:px-8">
          <span class="mb-3 block text-lg">{menu.contactTitle}</span>
          <address class="text-sm not-italic leading-relaxed text-third/75">
            <p>
              {menu.emailLabel}
              <a class="text-third underline decoration-secondary underline-offset-4" href={`mailto:${menu.email}`}> {menu.email} </a>
            </p>
            <p>{menu.location}</p>
          </address>
        </div>

        <footer class="relative px-5 pb-6 text-third sm:px-8">
          <nav aria-label={menu.socialAriaLabel}>
            <ul class="flex items-center gap-3">
              <li>
                <a class="grid size-10 place-items-center rounded-full border border-third/15 transition-colors hover:bg-white/50" href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
                  <FBIcon class="text-third" />
                </a>
              </li>
              <li>
                <a class="grid size-10 place-items-center rounded-full border border-third/15 transition-colors hover:bg-white/50" href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
                  <IGIcon class="text-third" />
                </a>
              </li>
            </ul>
          </nav>

          <LangButton
            href={langSwitcher.href}
            label={langSwitcher.label}
            className="absolute right-5 bottom-7 px-3 py-2 text-xs tracking-[0.16em] sm:right-8"
          />
        </footer>
      </div>
    </section>
  </div>
</aside>

<script>
  import { $ } from "../utils/dom";

  const $asideMenu = $<HTMLElement>("#aside-menu")!;
  const $panel = $("#aside-panel")!;
  const $closeButton = $("#close-button")!;
  const $burgerButton = $<HTMLButtonElement>("#burger-button")!;
  const $navLinks = $asideMenu.querySelectorAll<HTMLElement>("[data-nav-link]");

  let isOpen = false;

  const openMenu = () => {
    requestAnimationFrame(() => {
      $asideMenu.style.pointerEvents = "auto";
      $asideMenu.classList.remove("opacity-0");
      $asideMenu.classList.add("opacity-100");
      $asideMenu.setAttribute("aria-hidden", "false");
      $asideMenu.removeAttribute("inert");
      $burgerButton.setAttribute("aria-expanded", "true");

      document.body.style.overflow = "hidden";

      $panel.animate(
        [
          {
            transform: "translateX(100%)",
            opacity: 0,
            filter: "blur(4px)",
          },
          {
            transform: "translateX(0%)",
            opacity: 1,
            filter: "blur(0px)",
          },
        ],
        {
          duration: 350,
          easing: "ease-out",
          fill: "forwards",
        },
      );

      $closeButton?.focus();
    });

    isOpen = true;
  };

  const closeMenu = () => {
    $panel.animate(
      [
        {
          transform: "translateX(0%)",
          opacity: 1,
          filter: "blur(0px)",
        },
        {
          transform: "translateX(100%)",
          opacity: 0,
          filter: "blur(4px)",
        },
      ],
      {
        duration: 280,
        easing: "ease-in",
        fill: "forwards",
      },
    );

    $asideMenu.classList.remove("opacity-100");
    $asideMenu.classList.add("opacity-0");
    $asideMenu.setAttribute("aria-hidden", "true");
    $burgerButton.setAttribute("aria-expanded", "false");

    setTimeout(() => {
      $asideMenu.style.pointerEvents = "none";
      $asideMenu.setAttribute("inert", "");
      document.body.style.overflow = "";
    }, 280);

    isOpen = false;
  };

  const toggleMenu = () => {
    isOpen ? closeMenu() : openMenu();
  };

  window.addEventListener("aside-toggle", toggleMenu);

  $closeButton?.addEventListener("click", closeMenu);

  $asideMenu.addEventListener("click", (e) => {
    if (e.target === $asideMenu) closeMenu();
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) closeMenu();
  });

  $navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");

      if (href && href.startsWith("#")) {
        e.preventDefault();
        closeMenu();

        document.querySelector(href)?.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });
</script>
