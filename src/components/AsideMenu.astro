---
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LANGUAGE } from "../i18n/utils";
import IsotypeAnchor from "./IsotypeAnchor.astro";
import CrossButton from "./CrossButton.astro";
import RightArrow from "./icons/RightArrow.astro";
import FBIcon from "./icons/FBIcon.astro";
import IGIcon from "./icons/IGIcon.astro";

const homeUrl = getRelativeLocaleUrl(Astro.currentLocale ?? DEFAULT_LANGUAGE);

interface navLinks {
  label: string;
  description: string;
  url: string;
}

const { navLinks } = Astro.props;
---

<aside
  id="aside-menu"
  class="fixed inset-0 z-20 pointer-events-none opacity-0 transition-opacity duration-300 bg-black/30 backdrop-blur-sm lg:hidden"
>
  <!-- PANEL -->
  <div
    id="aside-panel"
    class="absolute inset-0 md:inset-y-0 md:right-0 md:left-auto md:w-[420px] bg-[#DEF3F4] flex flex-col will-change-transform"
    style="transform: translateX(100%); opacity: 0; filter: blur(4px);"
  >
    <header class="flex justify-between text-black py-5 px-5">
      <IsotypeAnchor homeUrl={homeUrl} />
      <CrossButton />
    </header>

    <section class="flex flex-col flex-1 h-dvh">
      <div class="flex-1 overflow-y-auto">
        <nav>
          <ul class="pt-5">
            {
              Object.values(navLinks).map((x) => (
                <li>
                  <a
                    data-nav-link
                    class="text-third pb-5 px-5 flex justify-between items-center"
                    href={`${x.url}`}
                  >
                    <div class="flex flex-col uppercase gap-1">
                      {x.label}
                      <span class="normal-case opacity-70">
                        {x.description}
                      </span>
                    </div>
                    <RightArrow class="text-third" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <hr class="text-third m-5 opacity-70" />
      </div>

      <div class="mt-auto">
        <div class="p-5 text-third">
          <h2 class="text-xl mb-4">Let's Connect</h2>
          <address>
            <p>
              Email:
              <a href="mailto:mardemedia@gmail.com"> mardemedia@gmail.com </a>
            </p>
            <p>Puerto Vallarta, Jalisco, México.</p>
          </address>
        </div>

        <div class="flex items-center mx-5">
          <div class="grow border-t border-third"></div>
          <span class="mx-4 text-third opacity-70">Follow Us</span>
          <div class="grow border-t border-third"></div>
        </div>

        <footer class="p-5 text-third">
          <nav aria-label="Social media">
            <ul class="flex gap-4 items-center justify-center">
              <li>
                <a href="https://facebook.com" target="_blank" rel="noopener">
                  <FBIcon class="text-third" />
                </a>
              </li>
              <li>
                <a href="https://instagram.com" target="_blank" rel="noopener">
                  <IGIcon class="text-third" />
                </a>
              </li>
            </ul>
          </nav>
        </footer>
      </div>
    </section>
  </div>
</aside>

<script>
  import { $, $$ } from "../utils/dom";

  const $asideMenu = $<HTMLElement>("#aside-menu")!;
  const $panel = $("#aside-panel")!;
  const $closeButton = $("#close-button")!;
  const $navLinks = $$("[data-nav-link]")!;

  let isOpen = false;

  const openMenu = () => {
    requestAnimationFrame(() => {
      $asideMenu.style.pointerEvents = "auto";
      $asideMenu.classList.remove("opacity-0");
      $asideMenu.classList.add("opacity-100");

      $panel.animate(
        [
          {
            transform: "translateX(100%)",
            opacity: 0,
            filter: "blur(4px)",
          },
          {
            transform: "translateX(0%)",
            opacity: 1,
            filter: "blur(0px)",
          },
        ],
        {
          duration: 350,
          easing: "ease-out",
          fill: "forwards",
        },
      );
    });

    isOpen = true;
  };

  const closeMenu = () => {
    $panel.animate(
      [
        {
          transform: "translateX(0%)",
          opacity: 1,
          filter: "blur(0px)",
        },
        {
          transform: "translateX(100%)",
          opacity: 0,
          filter: "blur(4px)",
        },
      ],
      {
        duration: 280,
        easing: "ease-in",
        fill: "forwards",
      },
    );

    $asideMenu.classList.remove("opacity-100");
    $asideMenu.classList.add("opacity-0");

    setTimeout(() => {
      $asideMenu.style.pointerEvents = "none";
    }, 280);

    isOpen = false;
  };

  const toggleMenu = () => {
    isOpen ? closeMenu() : openMenu();
  };

  window.addEventListener("aside-toggle", toggleMenu);

  $closeButton?.addEventListener("click", closeMenu);

  $asideMenu.addEventListener("click", (e) => {
    if (e.target === $asideMenu) closeMenu();
  });

  $navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");

      if (href && href.startsWith("#")) {
        e.preventDefault();
        closeMenu();

        document.querySelector(href)?.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });
</script>
