---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { lang } from "../../i18n/utils";

interface Props {
  lang: lang;
  className?: string;
}

const { lang, className }: Props = Astro.props;

const nextLang = lang === "es" ? "en" : "es";

const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|es)/, "") || "/";
const href = getRelativeLocaleUrl(nextLang, pathWithoutLocale);
---

<a href={href} class={`uppercase font-bold  ${className && className}`}>
  {nextLang}
</a>
