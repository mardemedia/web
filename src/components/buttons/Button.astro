---
const { text, className = "", as = "button", href, ...props } = Astro.props;

const Tag = as;
---

<Tag
  {...as === "a" ? { href } : {}}
  {...props}
  class={`group relative inline-flex min-h-13 w-full max-w-80 cursor-pointer items-center justify-center overflow-hidden bg-transparent px-5 transition-transform duration-300 hover:scale-[1.02] ${className && className}`}
>
  <span
    class="absolute top-0 left-0 h-px w-full origin-left scale-x-100 bg-white transition-transform duration-500 group-hover:scale-x-0"
  ></span>
  <span
    class="absolute bottom-0 left-0 h-px w-full origin-right scale-x-100 bg-white transition-transform duration-500 group-hover:scale-x-0"
  ></span>

  <span
    class="absolute top-0 right-0 h-8 w-px origin-top bg-white transition-transform duration-500 group-hover:scale-y-0"
  ></span>

  <span
    class="absolute top-0 left-0 h-2 w-px origin-top bg-white transition-transform duration-500 group-hover:scale-y-0"
  ></span>
  <span
    class="absolute bottom-0 left-0 h-6 w-px origin-bottom bg-white transition-transform duration-500 group-hover:scale-y-0"
  ></span>

  <span
    class="flex items-center justify-center text-center text-sm uppercase tracking-[0.2em] text-white transition-all duration-300 sm:text-base sm:tracking-[0.24em] group-hover:tracking-[0.28em]"
  >
    {text}
  </span>
</Tag>
