---
import type { LayoutCopy, HomePageCopy } from "../../i18n/content";
import type { lang } from "../../i18n/utils";
import MainLayout from "../../layouts/MainLayout.astro";
import Button from "../buttons/Button.astro";
import BubbleContainer from "../containers/BubbleContainer.astro";
import SectionContainer from "../containers/SectionContainer.astro";
import Hero from "../Hero.astro";
import ServicesBentoGrid from "../ServicesBentoGrid.astro";

interface ServiceItem {
  img: {
    mobile: string;
    desktop: string;
  };
  title: string;
  description?: string;
}

interface PackageItem {
  tag: string;
  title: string;
  description: string;
  features: string[];
}

interface Props {
  lang: lang;
  copy: HomePageCopy;
  layoutCopy: LayoutCopy;
  services: ServiceItem[];
  packages: PackageItem[];
}

const { lang, copy, layoutCopy, services, packages }: Props = Astro.props;
const introTitleLines = copy.intro.title.split("\n");
const servicesTitleLines = copy.services.title.split("\n");
const introHighlightLines = copy.intro.titleHighlight.split("\n");
const introTitleStart = introTitleLines[0].slice(0, -introHighlightLines[0].length);
const servicesHighlightLines = copy.services.titleHighlight.split("\n");
const servicesSecondLineStart = servicesTitleLines[1].slice(
  0,
  -servicesHighlightLines[0].length,
);
const [featuredProject, ...additionalProjects] = copy.projects.items;
const brandTitleParts = copy.brands.title.split(copy.brands.titleHighlight);
const projectTitleParts = copy.projects.title.split(copy.projects.titleHighlight);
const packageTitleParts = copy.packages.title.split(copy.packages.titleHighlight);
---

<MainLayout
  locale={lang}
  metaTitle={copy.meta.title}
  metaDescription={copy.meta.description}
  copy={layoutCopy}
>
  <Hero
    titleStart={copy.hero.titleStart}
    titleHighlight={copy.hero.titleHighlight}
    cta={copy.hero.cta}
  />

  <div
    class="h-full overflow-hidden bg-[linear-gradient(180deg,#22afb3_0%,#247f98_40%,#303158_100%)]"
  >
    <div class="relative overflow-hidden">
      <BubbleContainer />

    <SectionContainer
      id="intro-section"
      className="items-center pb-10! sm:pb-12! lg:pb-16!"
    >
      <h2
        class="max-w-4xl text-balance text-[clamp(2.25rem,5vw,4.75rem)] leading-[1.02] tracking-[-0.04em]"
      >
        {introTitleStart}<span class="text-secondary">
          {introHighlightLines[0]}<br />{introHighlightLines[1]}
        </span>
      </h2>

      <p class="max-w-2xl text-pretty text-base leading-relaxed text-white/85 sm:text-lg lg:text-xl">
        {copy.intro.description}
      </p>
    </SectionContainer>

    <section
      id="services-section"
      class="mx-auto w-full max-w-[1600px] px-5 pt-8 pb-20 sm:px-8 sm:pt-10 sm:pb-24 lg:px-16 lg:pt-12 lg:pb-32"
    >
      <header class="mb-10 flex flex-col items-center gap-7 text-center sm:mb-14 lg:flex-row lg:items-end lg:justify-between lg:text-left">
        <div>
          <p class="mb-4 text-xs uppercase tracking-[0.32em] text-secondary">
            {copy.packages.eyebrow}
          </p>
          <h2
            class="max-w-3xl text-balance text-[clamp(2.4rem,5vw,5rem)] leading-[1.02] tracking-[-0.04em]"
          >
            {servicesTitleLines[0]} {servicesSecondLineStart}<span class="text-secondary">
              {servicesHighlightLines[0]}<br />{servicesHighlightLines[1]}
            </span>
          </h2>
        </div>

        <Button
          text={copy.services.cta}
          as="a"
          href="#contact-section"
          className="lg:mx-0 lg:mb-1"
        />
      </header>

      <ServicesBentoGrid services={services} />
    </section>

    <section
      id="brands-section"
      class="relative mx-auto w-full max-w-[1600px] px-5 py-20 sm:px-8 sm:py-24 lg:px-16 lg:py-32"
    >
      <header class="mb-10 grid gap-7 sm:mb-14 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.65fr)] lg:items-end">
        <div>
          <p class="mb-4 text-xs uppercase tracking-[0.32em] text-secondary">
            {copy.brands.eyebrow}
          </p>
          <h2
            class="max-w-4xl text-balance text-[clamp(2.75rem,6vw,5.5rem)] leading-none tracking-[-0.05em] text-white"
          >
            {brandTitleParts[0]}<span class="text-secondary">{copy.brands.titleHighlight}</span>{brandTitleParts[1]}
          </h2>
        </div>

        <div class="flex flex-col items-start gap-6 lg:items-end">
          <p
            class="max-w-xl text-pretty text-base leading-relaxed text-white/75 lg:text-right lg:text-lg"
          >
            {copy.brands.description}
          </p>
          <Button
            as="a"
            text={copy.brands.cta}
            href="#projects-section"
            className="lg:mx-0"
          />
        </div>
      </header>

      <div class="grid gap-5 lg:grid-cols-2 lg:gap-6">
        {
          copy.brands.items.map((brand, index) => (
            <article class="group relative overflow-hidden rounded-[2rem] border border-white/25 bg-white/[0.08] p-6 shadow-[0_24px_60px_rgba(20,26,58,0.14)] backdrop-blur-xl sm:p-8 lg:p-10">
              <div
                aria-hidden="true"
                class="absolute -top-24 -right-24 size-64 rounded-full bg-white/[0.06] blur-2xl transition-transform duration-700 group-hover:scale-110"
              ></div>

              <div class="relative grid min-h-[18rem] gap-8 sm:grid-cols-[minmax(10rem,0.72fr)_minmax(0,1fr)] sm:items-center lg:min-h-[20rem]">
                <div class="mx-auto grid aspect-square w-full max-w-56 place-items-center overflow-hidden rounded-full border border-white/20 bg-[#DEF3F4] p-7 shadow-[0_20px_50px_rgba(20,26,58,0.2)] sm:p-8">
                  <img
                    src={brand.image}
                    alt={brand.imageAlt}
                    loading="lazy"
                    decoding="async"
                    class="max-h-44 w-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.05]"
                  />
                </div>

                <div class="flex min-w-0 flex-col justify-center">
                  <span
                    class="mb-10 text-sm tracking-[0.25em] text-white/35"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="mb-3 text-xs uppercase tracking-[0.25em] text-secondary">
                    {brand.services.join(" · ")}
                  </p>
                  <h3 class="text-balance text-3xl leading-none tracking-[-0.04em] text-white sm:text-4xl">
                    {brand.name}
                  </h3>
                  <div class="mt-7 h-px w-16 bg-white/25 transition-[width] duration-500 group-hover:w-28"></div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="projects-section"
      class="scroll-mt-20 px-5 py-20 sm:px-8 sm:py-24 lg:px-16 lg:py-32"
    >
      <div class="mx-auto w-full max-w-[1472px]">
        <header class="mb-10 grid gap-6 sm:mb-14 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:items-end">
          <div>
            <p class="mb-4 text-xs uppercase tracking-[0.32em] text-secondary">
              {copy.projects.eyebrow}
            </p>
            <h2 class="max-w-3xl text-balance text-[clamp(2.75rem,6vw,5.5rem)] leading-none tracking-[-0.05em] text-white">
              {projectTitleParts[0]}<span class="text-secondary">{copy.projects.titleHighlight}</span>{projectTitleParts[1]}
            </h2>
          </div>
          <p class="max-w-xl text-pretty text-base leading-relaxed text-white/75 lg:justify-self-end lg:text-lg">
            {copy.projects.description}
          </p>
        </header>

        {
          featuredProject && (
            <article class="group overflow-hidden rounded-[2rem] border border-white/15 bg-[#0c0715] shadow-[0_30px_90px_rgba(20,26,58,0.3)] lg:grid lg:min-h-[36rem] lg:grid-cols-[0.9fr_1.1fr]">
              <div class="relative z-10 flex flex-col justify-between p-7 sm:p-10 lg:p-12 xl:p-14">
                <div class="flex flex-wrap items-center gap-2">
                  {featuredProject.status && (
                    <span class="rounded-full bg-secondary px-4 py-2 text-[0.68rem] uppercase tracking-[0.2em] text-third">
                      {featuredProject.status}
                    </span>
                  )}
                  <span class="rounded-full border border-white/20 px-4 py-2 text-[0.68rem] uppercase tracking-[0.2em] text-white/80">
                    {featuredProject.category}
                  </span>
                </div>

                <div class="mt-16 lg:mt-12">
                  <p class="mb-4 text-xs tracking-[0.25em] text-white/45">01</p>
                  <h3 class="text-balance text-[clamp(2.75rem,5vw,5rem)] leading-none tracking-[-0.055em] text-white">
                    {featuredProject.title}
                  </h3>
                  <p class="mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg">
                    {featuredProject.description}
                  </p>

                  {featuredProject.features && (
                    <ul class="mt-7 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" aria-label={featuredProject.title}>
                      {featuredProject.features.map((feature) => (
                        <li class="border-l border-[#863bff] pl-3 text-sm leading-snug text-white/70">
                          {feature}
                        </li>
                      ))}
                    </ul>
                  )}

                  {featuredProject.url && (
                    <a
                      href={featuredProject.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-9 inline-flex items-center gap-3 border-b border-secondary pb-2 text-sm uppercase tracking-[0.18em] text-white transition-colors hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
                    >
                      {featuredProject.visitLabel}
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>

              <div class="relative min-h-[24rem] overflow-hidden border-t border-white/10 bg-[radial-gradient(circle_at_50%_44%,rgba(126,20,255,0.34),transparent_46%)] sm:min-h-[30rem] lg:min-h-full lg:border-t-0 lg:border-l">
                <div class="absolute inset-8 rounded-[2rem] border border-white/8 sm:inset-12"></div>
                <div class="absolute inset-16 rounded-[2rem] border border-[#863bff]/18 sm:inset-24"></div>
                <picture class="absolute inset-0 grid place-items-center">
                  <source media="(min-width: 768px)" srcset={featuredProject.image.desktop} />
                  <img
                    src={featuredProject.image.mobile}
                    alt={featuredProject.imageAlt}
                    loading="lazy"
                    decoding="async"
                    class="h-[68%] w-[68%] object-contain opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                  />
                </picture>
              </div>
            </article>
          )
        }

        {
          additionalProjects.length > 0 && (
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {additionalProjects.map((project, index) => (
                <article class="overflow-hidden rounded-[1.75rem] border border-white/15 bg-third/20 p-7 sm:p-9">
                  <p class="mb-12 text-xs tracking-[0.25em] text-white/45">
                    {String(index + 2).padStart(2, "0")}
                  </p>
                  <p class="mb-3 text-xs uppercase tracking-[0.22em] text-secondary">
                    {project.category}
                  </p>
                  <h3 class="text-3xl tracking-[-0.04em] text-white">{project.title}</h3>
                  <p class="mt-4 leading-relaxed text-white/70">{project.description}</p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section
      id="packages-section"
      class="mx-auto w-full max-w-[1600px] px-5 py-20 sm:px-8 sm:py-24 lg:px-16 lg:py-32"
    >
      <div class="mx-auto">
        <div class="mb-10 sm:mb-14">
          <div>
            <p
              class="mb-4 text-xs font-medium uppercase tracking-[0.32em] text-secondary"
            >
              {copy.packages.eyebrow}
            </p>

            <h2
              class="max-w-xl text-[clamp(2.75rem,6vw,5.5rem)] leading-none tracking-[-0.05em] text-white"
            >
              {packageTitleParts[0]}<span class="text-secondary">{copy.packages.titleHighlight}</span>{packageTitleParts[1]}
            </h2>
          </div>
        </div>

        <div class="divide-y divide-white/15 border-y border-white/15">
          {
            packages.map((item, index) => (
              <article class="group grid gap-x-7 gap-y-7 py-10 transition-colors duration-300 hover:bg-white/[0.025] sm:grid-cols-[64px_minmax(0,1fr)] sm:px-4 sm:py-12 lg:grid-cols-[80px_240px_minmax(0,1fr)] lg:gap-x-8 lg:px-6 lg:py-14 xl:grid-cols-[80px_240px_minmax(0,1fr)_260px_56px] xl:items-start xl:px-8">
                <div class="text-4xl leading-none text-white/20 sm:row-span-3 sm:text-5xl lg:row-span-1">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="sm:col-start-2 lg:col-start-auto">
                  <p class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-secondary">
                    {item.tag}
                  </p>

                  <h3 class="text-balance text-3xl leading-[1.05] tracking-[-0.035em] text-white lg:text-4xl">
                    {item.title}
                  </h3>
                </div>

                <p class="text-sm leading-relaxed text-white/82 sm:col-start-2 sm:text-base lg:col-start-auto lg:text-lg">
                  {item.description}
                </p>

                <div class="sm:col-start-2 lg:col-span-2 lg:col-start-2 xl:col-span-1 xl:col-start-auto">
                  <h4 class="mb-4 text-xs uppercase tracking-[0.25em] text-white/55">
                    {copy.packages.includes}
                  </h4>
                  <ul class="grid gap-2.5 text-sm leading-relaxed text-white/75 sm:grid-cols-2 lg:text-base xl:grid-cols-1">
                    {item.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-secondary"></span>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <Button
                  as="a"
                  text="→"
                  aria-label={`${copy.packages.viewLabel} ${item.title}`}
                  href="#contact-section"
                  className="hidden! xl:inline-flex! xl:size-14! xl:self-center! xl:px-0!"
                />

                <Button
                  as="a"
                  text={copy.services.cta}
                  aria-label={`${copy.packages.viewLabel} ${item.title}`}
                  href="#contact-section"
                  className="sm:col-start-2 lg:col-span-2 lg:col-start-2 xl:hidden"
                />
              </article>
            ))
          }
        </div>
      </div>
    </section>
    </div>

    <section
      class="relative flex min-h-[32rem] items-center justify-center overflow-hidden sm:min-h-[36rem] lg:min-h-[42rem]"
      id="contact-section"
    >
      <img
        src="/contact.webp"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 size-full object-cover"
      />
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(#30315880, #303158e0);"
      ></div>

      <div
        class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center justify-center gap-8 px-5 py-20 text-center sm:px-8 lg:px-16"
      >
        <p class="text-xs uppercase tracking-[0.32em] text-secondary">
          Mar de Media
        </p>
        <h2
          class="max-w-5xl text-balance text-[clamp(2.25rem,5.8vw,5.5rem)] leading-[1.02] tracking-[-0.045em]"
        >
          {copy.contact.titleStart}
          <span class="text-secondary">
            {copy.contact.titleHighlight}
          </span>
          <br />
          {copy.contact.titleEnd}
        </h2>

        <Button
          as="a"
          text={copy.contact.cta}
          className="mt-2"
          href="mailto:mardemedia@gmail.com"
        />
      </div>
    </section>
  </div>
</MainLayout>
