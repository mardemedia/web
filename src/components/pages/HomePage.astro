---
import { getEnglishLabel, getSpanishLabel, type lang } from "../../i18n/utils";
import MainLayout from "../../layouts/MainLayout.astro";
import { getAllPackages } from "../../services/packages.service";
import { getAllServices } from "../../services/services.service";
import Button from "../buttons/Button.astro";
import Carousel from "../Carousel.astro";
import SectionContainer from "../containers/SectionContainer.astro";
import Hero from "../Hero.astro";

interface Props {
  lang: lang;
}

const { lang }: Props = Astro.props;

const t = lang === "es" ? getSpanishLabel : getEnglishLabel;
const services = await getAllServices(lang);
const packages = await getAllPackages(lang);
---

<MainLayout metaTitle={t("meta.title")} metaDescription={t("meta.description")}>
  <Hero lang={lang} />

  <div class="h-full bg-linear-to-t from-third to-primary">
    <SectionContainer id="intro-section">
      <h2 class="text-4xl lg:text-6xl">
        {t("intro.title").split("\n")[0]}
        <br />
        {t("intro.title").split("\n")[1]}
      </h2>

      <p class="lg:text-xl">
        {t("intro.description")}
      </p>
    </SectionContainer>

    <section
      id="services-section"
      class="px-5 lg:grid lg:grid-cols-2 lg:items-center lg:p-16 max-w-7xl mx-auto xl:max-w-[100rem]"
    >
      <div class="flex flex-col items-start gap-12">
        <h2 class="text-3xl lg:text-5xl text-start">
          {t("services.title").split("\n")[0]}
          <em class="text-secondary"> {t("services.title").split("\n")[1]}</em>
          <br />
          {t("services.title").split("\n")[2]}
        </h2>

        <Button text={t("services.cta")} as="a" href="#contact-section" />
      </div>

      <Carousel slides={services} />
    </section>

    <section
      id="packages-section"
      class="bg-transparent px-5 py-20 lg:px-16 lg:py-28 max-w-7xl mx-auto xl:max-w-[100rem]"
    >
      <div class="mx-auto">
        <div class="mb-24 lg:mb-10">
          <p
            class="mb-2 text-xs font-medium uppercase tracking-[0.35em] text-white italic"
          >
            {t("packages.eyebrow")}
          </p>

          <h2
            class="max-w-xl text-5xl leading-none tracking-tight text-white lg:text-7xl"
          >
            {t("packages.title")}
          </h2>
        </div>

        <div class="divide-y divide-primary/15">
          {
            packages.map((item, index) => (
              <article class="grid gap-8 py-12 lg:grid-cols-[90px_260px_1fr_280px_48px] lg:items-start lg:gap-8">
                <div class="text-5xl leading-none text-white/15 lg:text-6xl">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div>
                  <p class="mb-4 text-xs font-medium uppercase tracking-[0.35em] text-secondary">
                    {item.tag}
                  </p>

                  <h3 class="text-3xl leading-none tracking-tight text-white lg:text-4xl">
                    {item.title}
                  </h3>
                </div>

                <p class="max-w-md text-base leading-relaxed text-white lg:text-lg">
                  {item.description}
                </p>

                <ul class="space-y-2 text-sm leading-relaxed text-white/75 lg:text-base">
                  {item.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>

                <a
                  href="#contact-section"
                  aria-label={`${t("packages.viewLabel")} ${item.title}`}
                  class="flex size-12 items-center justify-center border border-white/55 text-white/55 transition hover:border-white hover:text-white"
                >
                  →
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative" id="contact-section">
      <img
        src="/contact.webp"
        alt=""
        class="w-full aspect-square md:aspect-video lg:aspect-21/9 object-cover opacity-30"
      />

      <div
        class="absolute inset-0 p-4 flex flex-col justify-center items-center gap-4 text-center"
      >
        <h2 class="text-3xl md:text-4xl lg:text-5xl md:w-2/3">
          {lang === "es" ? "Tu viaje hacia " : "Your journey to "}
          <span class="text-secondary">
            {t("contact.highlight")}
          </span>
          {lang === "es" ? " comienza aquí." : " starts here."}
        </h2>

        <Button text={t("contact.cta")} className="w-2/3 md:w-auto" />
      </div>
    </section>
  </div>
</MainLayout>
