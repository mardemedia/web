---
import type { LayoutCopy, HomePageCopy } from "../../i18n/content";
import type { lang } from "../../i18n/utils";
import MainLayout from "../../layouts/MainLayout.astro";
import Button from "../buttons/Button.astro";
import Carousel from "../Carousel.astro";
import SectionContainer from "../containers/SectionContainer.astro";
import Hero from "../Hero.astro";

interface ServiceItem {
  img: {
    mobile: string;
    desktop: string;
  };
  title: string;
}

interface PackageItem {
  tag: string;
  title: string;
  description: string;
  features: string[];
}

interface Props {
  lang: lang;
  copy: HomePageCopy;
  layoutCopy: LayoutCopy;
  services: ServiceItem[];
  packages: PackageItem[];
}

const { lang, copy, layoutCopy, services, packages }: Props = Astro.props;
const introTitleLines = copy.intro.title.split("\n");
const servicesTitleLines = copy.services.title.split("\n");
---

<MainLayout
  locale={lang}
  metaTitle={copy.meta.title}
  metaDescription={copy.meta.description}
  copy={layoutCopy}
>
  <Hero
    titleStart={copy.hero.titleStart}
    titleHighlight={copy.hero.titleHighlight}
    cta={copy.hero.cta}
  />

  <div class="h-full bg-linear-to-t from-third to-primary">
    <SectionContainer id="intro-section">
      <h2 class="text-4xl lg:text-6xl">
        {introTitleLines[0]}
        <br />
        {introTitleLines[1]}
      </h2>

      <p class="lg:text-xl">
        {copy.intro.description}
      </p>
    </SectionContainer>

    <section
      id="services-section"
      class="px-5 flex flex-col gap-4 items-center
         xl:grid xl:grid-cols-[0.7fr_1.3fr] xl:items-center
         xl:gap-x-8 lg:p-16
         max-w-7xl mx-auto xl:max-w-400"
    >
      <div class="flex flex-col items-center md:items-start gap-12 py-2">
        <h2 class="text-3xl lg:text-5xl text-center xl:text-start">
          {servicesTitleLines[0]}
          <em class="text-secondary"> {servicesTitleLines[1]}</em>
          <br />
          {servicesTitleLines[2]}
        </h2>

        <Button
          text={copy.services.cta}
          as="a"
          href="#contact-section"
          className="hidden! xl:inline-flex! lg:mx-auto xl:mx-0"
        />
      </div>

      <Carousel slides={services} />

      <Button
        text={copy.services.cta}
        as="a"
        href="#contact-section"
        className="xl:hidden"
      />
    </section>

    <section
      id="packages-section"
      class="bg-transparent px-5 py-10 md:py-20 lg:px-16 lg:pb-28 lg:pt-0 max-w-7xl mx-auto xl:max-w-400"
    >
      <div class="mx-auto">
        <div class="lg:mb-10">
          <p
            class="mb-2 text-xs font-medium uppercase tracking-[0.35em] text-white italic"
          >
            {copy.packages.eyebrow}
          </p>

          <h2
            class="max-w-xl text-5xl leading-none tracking-tight text-white lg:text-7xl"
          >
            {copy.packages.title}
          </h2>
        </div>

        <div class="divide-y divide-primary/15">
          {
            packages.map((item, index) => (
              <article class="grid gap-8 py-12 lg:grid-cols-[90px_260px_auto] xl:grid-cols-[90px_260px_1fr_280px_48px] lg:items-start lg:gap-8">
                <div class="text-5xl leading-none text-white/15 lg:text-6xl">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div>
                  <p class="mb-4 text-xs font-medium uppercase tracking-[0.35em] text-secondary">
                    {item.tag}
                  </p>

                  <h3 class="text-3xl leading-none tracking-tight text-white lg:text-4xl">
                    {item.title}
                  </h3>
                </div>

                <p class=" text-base leading-relaxed text-white lg:text-lg">
                  {item.description}
                </p>

                <div class="lg:hidden xl:block">
                  <h4 class="lg:hidden text-center pb-4">
                    {copy.packages.includes}
                  </h4>
                  <ul class="flex flex-wrap gap-x-4 justify-center lg:block space-y-2 text-sm leading-relaxed text-white/75 lg:text-base">
                    {item.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>

                <Button
                  as="a"
                  text="->"
                  aria-label={`${copy.packages.viewLabel} ${item.title}`}
                  href="#contact-section"
                  className="hidden! xl:flex! xl:self-center! w-12!"
                />

                <Button
                  text={copy.services.cta}
                  as="a"
                  href="#contact-section"
                  className="mx-auto xl:mx-0 xl:hidden col-span-full self-center"
                />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative" id="contact-section">
      <img
        src="/contact.webp"
        alt=""
        class="w-full aspect-square md:aspect-video lg:aspect-21/9 object-cover opacity-30"
      />

      <div
        class="absolute inset-0 p-4 flex flex-col justify-center items-center gap-4 text-center"
      >
        <h2 class="text-3xl md:text-4xl lg:text-5xl md:w-2/3">
          {copy.contact.titleStart}
          <span class="text-secondary">
            {copy.contact.titleHighlight}
          </span>
          <br />
          {copy.contact.titleEnd}
        </h2>

        <Button
          as="a"
          text={copy.contact.cta}
          className="w-2/3"
          href="mailto:mardemedia@gmail.com"
        />
      </div>
    </section>
  </div>
</MainLayout>
