---
import BurguerButton from "./buttons/BurgerButton.astro";
import AsideMenu from "./AsideMenu.astro";
import LangButton from "./buttons/LangButton.astro";
import type { HeaderCopy } from "../i18n/content";

interface Props {
  copy: HeaderCopy;
}

const { copy }: Props = Astro.props;
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full bg-[#DEF3F4] transition-[background-color,box-shadow] duration-300"
>
  <div
    class="mx-auto flex min-h-18 w-full max-w-[1600px] items-center justify-between px-5 sm:px-8 lg:px-16"
  >
    <a
      href={copy.brand.homeUrl}
      class="inline-flex shrink-0 items-center gap-3"
      aria-label={copy.brand.logoAlt}
    >
      <img
        src={copy.brand.mobileLogoSrc}
        alt=""
        aria-hidden="true"
        width="48"
        height="48"
        class="h-9 w-auto sm:h-10 lg:h-12"
      />
      <span
        class="hidden whitespace-nowrap text-center text-xs uppercase leading-none tracking-[0.12em] text-third/80 lg:block"
      >
        {copy.brand.tagline}
      </span>
    </a>
    <BurguerButton />
    <AsideMenu
      navLinks={copy.navLinks}
      brand={copy.brand}
      langSwitcher={copy.langSwitcher}
      menu={copy.menu}
    />
    <nav class="hidden lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-1 xl:gap-3">
        <li>
          <LangButton
            href={copy.langSwitcher.href}
            label={copy.langSwitcher.label}
            className="text-third mr-2 px-3 py-2 text-xs tracking-[0.16em] transition-colors hover:text-primary"
          />
        </li>
        {
          copy.navLinks.map((x) => (
            <li>
              <a
                data-nav-link
                class="text-third px-3 py-2 flex justify-between items-center relative text-sm
                 after:content-[''] after:absolute after:left-0 after:bottom-0
                 after:h-0.5 after:w-full after:bg-secondary
                 after:scale-x-0 after:origin-left
                 after:transition-transform after:duration-300
                 hover:after:scale-x-100"
                href={`${x.url}`}
              >
                {x.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  #main-header {
    position: sticky;
    top: 0;
  }

  #main-header.header-scrolled {
    background-color: rgb(222 243 244 / 0.8);
    box-shadow: 0 10px 30px rgb(48 49 88 / 0.08);
  }
</style>

<script>
  import { $ } from "../utils/dom";

  const $burguerButton = $<HTMLButtonElement>("#burger-button")!;
  $burguerButton.addEventListener("click", () => {
    window.dispatchEvent(new Event("aside-toggle"));
  });

  const header = $("#main-header")!;

  let animationFrame = 0;
  let isScrolled = false;

  const updateHeader = () => {
    animationFrame = 0;
    const nextScrolledState = window.scrollY > 10;

    if (nextScrolledState === isScrolled) return;

    isScrolled = nextScrolledState;
    header.classList.toggle("header-scrolled", isScrolled);
  };

  const requestHeaderUpdate = () => {
    if (animationFrame) return;
    animationFrame = window.requestAnimationFrame(updateHeader);
  };

  window.addEventListener("scroll", requestHeaderUpdate, { passive: true });
  updateHeader();
</script>
