---
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LANGUAGE, type lang } from "../i18n/utils";
import BurguerButton from "./buttons/BurgerButton.astro";
import AsideMenu from "./AsideMenu.astro";
import IsotypeAnchor from "./IsotypeAnchor.astro";
import LangButton from "./buttons/LangButton.astro";

interface Props {
  lang: lang;
}
interface navLinks {
  label: string;
  description: string;
  url: string;
}
const navLinks: Record<string, navLinks> = {
  home: {
    label: "Home",
    description: "Get back to home page",
    url: "/",
  },
  services: {
    label: "Services",
    description: "Take a dive into our services",
    url: "#services-section",
  },
  packages: {
    label: "Packages",
    description: "Personalized packages for you",
    url: "#packages-section",
  },
  contact: {
    label: "Contact us",
    description: "Connect with us",
    url: "#contact-section",
  },
};

const { lang } = Astro.props;
const homeUrl = getRelativeLocaleUrl(Astro.currentLocale ?? DEFAULT_LANGUAGE);
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full flex justify-between items-center p-5 md:p-2 bg-[#DEF3F4] transition-shadow duration-300"
>
  <IsotypeAnchor homeUrl={homeUrl} />
  <BurguerButton />
  <AsideMenu navLinks={navLinks} />
  <nav class="hidden lg:block">
    <ul class="flex gap-2">
      <LangButton
        lang={lang}
        className="text-third pb-1 px-2 flex justify-between items-center relative
                 after:content-[''] after:absolute after:left-0 after:bottom-0
                 after:h-0.5 after:w-full after:bg-secondary
                 after:scale-x-0 after:origin-left
                 after:transition-transform after:duration-300
                 hover:after:scale-x-100"
      />
      {
        Object.values(navLinks).map((x) => (
          <li>
            <a
              data-nav-link
              class="text-third pb-1 px-2 flex justify-between items-center relative
                 after:content-[''] after:absolute after:left-0 after:bottom-0
                 after:h-0.5 after:w-full after:bg-secondary
                 after:scale-x-0 after:origin-left
                 after:transition-transform after:duration-300
                 hover:after:scale-x-100"
              href={`${x.url}`}
            >
              {x.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import { $ } from "../utils/dom";

  const $burguerButton = $<HTMLButtonElement>("#burger-button")!;
  $burguerButton.addEventListener("click", () => {
    window.dispatchEvent(new Event("aside-toggle"));
  });

  const header = $("#main-header")!;

  window.addEventListener("scroll", () => {
    if (window.scrollY > 10) {
      header.classList.add(
        "shadow-[0_6px_16px_rgba(0,0,0,0.06)]",
        "bg-[#DEF3F4]/90",
      );
    } else {
      header.classList.remove(
        "shadow-[0_6px_16px_rgba(0,0,0,0.06)]",
        "bg-[#DEF3F4]/90",
      );
      header.classList.add("bg-[#DEF3F4]");
    }
  });
</script>
