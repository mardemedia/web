---
import type { lang } from "../i18n/utils";

interface Props {
  homeUrl: string;
  lang: lang;
}
const { homeUrl, lang }: Props = Astro.props;
---

<a href={homeUrl}>
  <picture>
    <source
      media="(min-width: 768px)"
      srcset={`/imagotipo-mar-de-media-${lang}.svg`}
    />

    <img src="/isotype.svg" alt="Mar de Media" class="w-1/6 md:w-full" />
  </picture>
</a>
