---
import LogoEs from "../../public/imagotipo-mar-de-media-es.svg?raw";
import LogoEn from "../../public/imagotipo-mar-de-media-en.svg?raw";

import type { lang } from "../i18n/utils";

interface Props {
  homeUrl: string;
  lang: lang;
}
const { homeUrl, lang }: Props = Astro.props;
const logo = lang === "es" ? LogoEs : LogoEn;
---

<a
  href={homeUrl}
  class="block w-12 md:w-64 [&>svg]:w-full [&>svg]:h-auto"
  set:html={logo}
/>
