---
interface Props {
  homeUrl: string;
  desktopLogoSrc: string;
  mobileLogoSrc: string;
  alt: string;
}
const { homeUrl, desktopLogoSrc, mobileLogoSrc, alt }: Props = Astro.props;
---

<a href={homeUrl} class="inline-flex shrink-0 items-center" aria-label={alt}>
  <picture>
    <source media="(min-width: 768px)" srcset={desktopLogoSrc} />

    <img
      src={mobileLogoSrc}
      alt={alt}
      class="h-9 w-auto md:h-11 lg:h-12"
      width="190"
      height="48"
    />
  </picture>
</a>
