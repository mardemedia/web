---
interface Props {
  homeUrl: string;
  desktopLogoSrc: string;
  mobileLogoSrc: string;
  alt: string;
}
const { homeUrl, desktopLogoSrc, mobileLogoSrc, alt }: Props = Astro.props;
---

<a href={homeUrl}>
  <picture>
    <source media="(min-width: 768px)" srcset={desktopLogoSrc} />

    <img src={mobileLogoSrc} alt={alt} class="w-1/6 md:w-full" />
  </picture>
</a>
