<button
  id="back-to-top"
  class="pointer-events-none fixed right-5 bottom-5 z-40 flex size-12 items-center justify-center
         rounded-full border border-third/10 bg-[#DEF3F4]/95 text-xl text-third shadow-[0_12px_30px_rgba(20,26,58,0.22)]
         opacity-0 backdrop-blur-md transition-all duration-300 hover:-translate-y-1 sm:right-8 sm:bottom-8"
  aria-label="Go to top"
>
  ↑
</button>

<style>
  @keyframes bounce-soft {
    0%,
    100% {
      transform: translateY(0);
    }

    60% { transform: translateY(-2px); }
  }

  .animate-bounce-soft {
    animation: bounce-soft 0.9s ease-in-out infinite;
  }
</style>

<script>
  const $btn = document.getElementById("back-to-top")!;

  const toggleVisibility = () => {
    if (!$btn) return;

    if (window.scrollY > 120) {
      $btn.style.opacity = "1";
      $btn.style.pointerEvents = "auto";
      $btn.classList.add("animate-bounce-soft");
    } else {
      $btn.style.opacity = "0";
      $btn.style.pointerEvents = "none";
      $btn.classList.remove("animate-bounce-soft");
    }
  };

  window.addEventListener("scroll", toggleVisibility, { passive: true });

  toggleVisibility();

  $btn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>
