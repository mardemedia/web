<button
  id="back-to-top"
  class="flex justify-center items-center pointer-events-none
         transition-all duration-300 w-10 h-10 p-3 rounded-full
         bg-[#DEF3F4] text-black shadow-lg fixed bottom-5 right-2 z-50
         opacity-0 cursor-pointer"
  aria-label="Go to top"
>
  ↑
</button>

<style>
  @keyframes bounce-soft {
    0%,
    100% {
      transform: translateY(0);
    }

    60% {
      transform: translateY(-3px);
    }
  }

  .animate-bounce-soft {
    animation: bounce-soft 0.9s ease-in-out infinite;
  }
</style>

<script>
  const $btn = document.getElementById("back-to-top")!;

  const toggleVisibility = () => {
    if (!$btn) return;

    if (window.scrollY > 100) {
      $btn.style.opacity = "1";
      $btn.style.pointerEvents = "auto";
      $btn.classList.add("animate-bounce-soft");
    } else {
      $btn.style.opacity = "0";
      $btn.style.pointerEvents = "none";
      $btn.classList.remove("animate-bounce-soft");
    }
  };

  window.addEventListener("scroll", toggleVisibility);

  toggleVisibility();

  $btn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>
