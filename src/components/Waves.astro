<svg
  xmlns="http://www.w3.org/2000/svg"
  class="waves"
  viewBox="0 0 402 66"
  fill="none"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <g class="wave-layer wave-layer--back">
    <path
      class="wave-track wave-track--back"
      d="M0 14C80 34 121 34 201 14C281 -6 322 -6 402 14C482 34 523 34 603 14C683 -6 724 -6 804 14V72H0Z"
      fill="currentColor"
    ></path>
  </g>

  <g class="wave-layer wave-layer--middle">
    <path
      class="wave-track wave-track--middle"
      d="M0 24C110 45 292 3 402 24C512 45 694 3 804 24V72H0Z"
      fill="currentColor"
    ></path>
  </g>

  <g class="wave-layer wave-layer--front">
    <path
      class="wave-track wave-track--front"
      d="M0 30C67 10 134 10 201 30C268 50 335 50 402 30C469 10 536 10 603 30C670 50 737 50 804 30V72H0Z"
      fill="currentColor"
    ></path>
  </g>
</svg>

<style>
  .waves {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .wave-layer,
  .wave-track {
    transform-box: fill-box;
    transform-origin: 0 0;
    will-change: transform;
  }

  .wave-layer--back {
    color: rgba(34, 175, 179, 0.3);
    animation: ocean-bob-back 5.5s ease-in-out infinite alternate;
  }

  .wave-layer--middle {
    color: rgba(34, 175, 179, 0.46);
    animation: ocean-bob-middle 4.6s ease-in-out -1.8s infinite alternate;
  }

  .wave-layer--front {
    color: #22afb3;
    animation: ocean-bob-front 3.8s ease-in-out -0.9s infinite alternate;
  }

  .wave-layer path {
    fill: currentColor;
  }

  .wave-track--back {
    animation: ocean-drift 22s linear -7s infinite reverse;
  }

  .wave-track--middle {
    animation: ocean-drift 16s linear -4s infinite;
  }

  .wave-track--front {
    animation: ocean-drift 11s linear -2s infinite;
  }

  @keyframes ocean-drift {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes ocean-bob-back {
    from {
      transform: translateY(-1.5px);
    }
    to {
      transform: translateY(1.5px);
    }
  }

  @keyframes ocean-bob-middle {
    from {
      transform: translateY(1px);
    }
    to {
      transform: translateY(-1.5px);
    }
  }

  @keyframes ocean-bob-front {
    from {
      transform: translateY(2px);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-layer,
    .wave-track {
      animation: none;
      transform: none;
    }
  }
</style>
