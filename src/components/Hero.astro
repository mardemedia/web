---
import Waves from "./Waves.astro";

interface Props {
  titleStart: string;
  titleHighlight: string;
  cta: string;
}

const { titleStart, titleHighlight, cta }: Props = Astro.props;
---

<section
  class="relative flex min-h-[68svh] flex-col items-center justify-between overflow-hidden bg-[#DEF3F4] lg:min-h-[74svh]"
>
  <div
    aria-hidden="true"
    class="absolute -left-24 top-12 size-64 rounded-full border border-primary/20 sm:size-80 lg:-left-32 lg:size-112"
  ></div>
  <div
    aria-hidden="true"
    class="absolute -right-20 bottom-8 size-52 rounded-full bg-primary/8 blur-2xl sm:size-72 lg:size-96"
  ></div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center gap-7 px-5 py-16 text-center text-third sm:px-8 lg:gap-9 lg:px-16"
  >
    <p class="text-xs uppercase tracking-[0.32em] text-primary sm:text-sm">
      Mar de Media · Puerto Vallarta
    </p>
    <h1
      class="max-w-5xl text-balance font-primary text-[clamp(2.5rem,7.2vw,6.5rem)] leading-[0.98] tracking-[-0.045em]"
    >
      {titleStart}
      <span class="relative inline-block text-secondary">
        {titleHighlight}
      </span>
    </h1>

    <a
      href="#contact-section"
      data-nav-link
      class="group relative flex items-center justify-center gap-3 px-1 pb-2 text-base text-third sm:text-lg
                 after:content-[''] after:absolute after:left-0 after:bottom-0
                 after:h-0.5 after:w-full after:bg-secondary
                 after:scale-x-100 after:origin-left
                 after:transition-transform after:duration-300
                 hover:after:scale-x-75"
    >
      {cta}
    </a>
  </div>

  <div class="relative z-10 h-18 w-full bg-linear-to-t from-primary to-[#DEF3F4] sm:h-24 lg:h-30">
    <Waves />
  </div>
</section>
