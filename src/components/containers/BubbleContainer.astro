<div
  id="bubble-container"
  class="pointer-events-none absolute inset-0 z-20 overflow-hidden opacity-70"
  aria-hidden="true"
>
</div>
<script>
  import random from "./../../utils/random";

  export function spawnBubble(root: HTMLElement | Element) {
    const isSeahorse = Math.random() < 0.18;
    const bubble = document.createElement(isSeahorse ? "img" : "bubble-svg");
    const isCompactViewport = window.matchMedia("(max-width: 639px)").matches;

    const size = isSeahorse
      ? random(isCompactViewport ? 42 : 50, isCompactViewport ? 60 : 78)
      : random(10, 75);
    const x = random(0, Math.max(0, root.clientWidth - size));
    const duration = isSeahorse ? random(14000, 20000) : random(5000, 10000);
    const opacity = isSeahorse ? random(0.2, 0.34) : random(0.3, 0.6);
    const totalTravel = root.clientHeight + 200;
    const driftX = random(isSeahorse ? -80 : -50, isSeahorse ? 80 : 50);
    const middleDriftX = driftX * 0.45 + random(-18, 18);
    const startRotation = isSeahorse ? random(-8, 8) : 0;
    const rotationDirection = Math.random() < 0.5 ? -1 : 1;
    const rotationAmount = isSeahorse
      ? random(30, 48) * rotationDirection
      : 0;
    const endRotation = startRotation + rotationAmount;

    if (isSeahorse) {
      bubble.setAttribute("src", "/seahorse.svg");
      bubble.setAttribute("alt", "");
      bubble.setAttribute("aria-hidden", "true");
      bubble.style.width = `${size}px`;
      bubble.style.height = "auto";
    } else {
      bubble.setAttribute("r", (size / 2).toString());
      bubble.setAttribute("color", "teal");
    }
    bubble.style.position = "absolute";
    bubble.style.left = `${x}px`;
    bubble.style.bottom = "-200px";
    bubble.style.opacity = opacity.toString();
    bubble.style.pointerEvents = "none";

    root.appendChild(bubble);

    bubble.animate(
      [
        {
          offset: 0,
          transform: `translate3d(0, 0, 0) rotate(${startRotation}deg)`,
          opacity,
        },
        {
          offset: 0.33,
          transform: `translate3d(${middleDriftX * 0.55}px, -${totalTravel * 0.33}px, 0) rotate(${startRotation + rotationAmount * 0.33}deg)`,
          opacity,
        },
        {
          offset: 0.66,
          transform: `translate3d(${middleDriftX}px, -${totalTravel * 0.66}px, 0) rotate(${startRotation + rotationAmount * 0.66}deg)`,
          opacity,
        },
        {
          offset: 1,
          transform: `translate3d(${driftX}px, -${totalTravel}px, 0) rotate(${endRotation}deg)`,
          opacity: 0,
        },
      ],
      {
        duration,
        easing: isSeahorse ? "linear" : "ease-out",
      },
    );

    setTimeout(() => bubble.remove(), duration);
  }

  export default function startBubbleLoop(root: HTMLElement | Element) {
    if (root instanceof HTMLElement) {
      if (getComputedStyle(root).position === "static") {
        root.style.position = "relative";
      }
      root.style.overflow = "hidden";
    }

    setInterval(() => spawnBubble(root), random(600, 1000));
  }

  requestAnimationFrame(() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const $container = document.getElementById("bubble-container")!;
    startBubbleLoop($container);
  });
</script>
