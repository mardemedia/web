---
import RightArrow from "./icons/RightArrow.astro";

interface Props {
  slides: {
    img: {
      mobile: string;
      desktop: string;
    };
    title: string;
    description?: string;
  }[];
  className?: string;
}
const { slides, className } = Astro.props;
---

<div class={`swiper mySwiper w-full mx-auto pb-8 ${className}`}>
  <div class="swiper-wrapper">
    {
      slides.map((slide) => (
        <article class="swiper-slide group relative cursor-grab overflow-hidden rounded-[1.75rem] border border-white/15 bg-transparent shadow-[0_24px_60px_rgba(20,26,58,0.2)] active:cursor-grabbing">
          <picture>
            <source media="(min-width: 1024px)" srcset={slide.img.desktop} />

            <img
              src={slide.img.mobile}
              alt={slide.title}
              class="block h-[clamp(20rem,46vw,29rem)] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </picture>
          <div class="absolute inset-0 bg-linear-to-t from-third/95 via-third/20 to-transparent" />
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
            <h3 class="text-2xl font-semibold leading-tight text-white sm:text-3xl">{slide.title}</h3>
            {slide.description && (
              <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-white/80 sm:text-base">
                {slide.description}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
  <button type="button" class="swiper-button-prev" aria-label="Previous service">
    <RightArrow class="h-3 w-3" />
  </button>
  <button type="button" class="swiper-button-next" aria-label="Next service">
    <RightArrow class="h-3 w-3" />
  </button>
</div>
<style is:global>
  @import "swiper/css";
  @import "swiper/css/pagination";
  @import "swiper/css/navigation";

  /* Tailwind resetea display:flex del wrapper, esto lo corrige */
  .mySwiper .swiper-wrapper {
    display: flex;
  }

  .mySwiper .swiper-slide {
    width: 100%;
    flex-shrink: 0;
    min-width: 0;
  }

  .mySwiper .swiper-button-prev,
  .mySwiper .swiper-button-next {
    top: 50%;
    bottom: auto;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: 0;
    border: 1px solid rgb(255 255 255 / 0.68);
    border-radius: 9999px;
    background: transparent;
    color: #ffffff;
    filter: drop-shadow(0 3px 8px rgb(20 26 58 / 0.45));
    transform: translateY(-50%);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      opacity 180ms ease;
  }

  .mySwiper .swiper-button-prev {
    right: auto;
    left: 0.75rem;
  }

  .mySwiper .swiper-button-next {
    right: 0.75rem;
  }

  .mySwiper .swiper-button-prev::after,
  .mySwiper .swiper-button-next::after {
    display: none;
  }

  .mySwiper .swiper-button-prev svg,
  .mySwiper .swiper-button-next svg {
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 0.75rem;
  }

  .mySwiper .swiper-button-prev:hover,
  .mySwiper .swiper-button-next:hover {
    border-color: #ffffff;
    transform: translateY(-50%) scale(1.06);
  }

  .mySwiper .swiper-button-disabled {
    opacity: 0.32;
  }

  @media (max-width: 639px) {
    .mySwiper {
      overflow: visible;
    }

    .mySwiper .swiper-button-prev,
    .mySwiper .swiper-button-next {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Pagination, Navigation } from "swiper/modules";

  new Swiper(".mySwiper", {
    modules: [Pagination, Navigation],
    loop: false,
    spaceBetween: 16,

    slidesPerView: 1,

    breakpoints: {
      640: {
        slidesPerView: 1.45,
      },
      1024: {
        slidesPerView: 2,
      },
      1440: {
        slidesPerView: 2.25,
      },
    },

    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });
</script>
