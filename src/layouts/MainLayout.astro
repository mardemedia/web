---
import "./../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import UpButton from "../components/UpButton.astro";
import type { lang } from "../i18n/utils";
import type { LayoutCopy } from "../i18n/content";
import SEOLayout from "./SEOLayout.astro";

interface Props {
  locale: lang;
  metaTitle: string;
  metaDescription: string;
  copy: LayoutCopy;
  className?: string;
}
const { locale, metaTitle, metaDescription, copy, className }: Props =
  Astro.props;

const isPreview = import.meta.env.VERCEL_ENV !== "production";
---

<SEOLayout
  metaDescription={metaDescription}
  metaTitle={metaTitle}
  isPreview={isPreview}
  locale={locale}
  className={className}
>
  <Header copy={copy.header} />
  <div class="flex-1">
    <slot />
  </div>
  <Footer rightsText={copy.footerRights} />
  <UpButton />
</SEOLayout>
