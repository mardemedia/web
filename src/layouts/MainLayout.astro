---
import "./../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BubbleContainer from "../components/containers/BubbleContainer.astro";
import UpButton from "../components/UpButton.astro";
import { getLangOrFallback, type lang } from "../i18n/utils";
import SEOLayout from "./SEOLayout.astro";

interface Props {
  metaTitle: string;
  metaDescription: string;
  className?: string;
}
const { metaTitle, metaDescription, className }: Props = Astro.props;

const isPreview = import.meta.env.VERCEL_ENV !== "production";
const locale: lang = getLangOrFallback(Astro.currentLocale);
---

<SEOLayout
  metaDescription={metaDescription}
  metaTitle={metaTitle}
  isPreview={isPreview}
  locale={locale}
  className={className}
>
  <BubbleContainer />
  <Header lang={locale} />
  <div class="flex-1">
    <slot />
  </div>
  <Footer lang={locale} />
  <UpButton />
</SEOLayout>
